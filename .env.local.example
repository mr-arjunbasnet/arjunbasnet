# SMTP Configuration for Contact Form
# Copy this file to .env.local and fill in your values.

# Gmail (recommended — use an App Password, not your main password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false

# Your sending address
SMTP_USER=mr.arjunbasnet@gmail.com
SMTP_PASS=your_gmail_app_password_here

# Who the email comes "from" (must match SMTP_USER for Gmail)
SMTP_FROM=mr.arjunbasnet@gmail.com

# Where contact messages are delivered
SMTP_TO=mr.arjunbasnet@gmail.com
